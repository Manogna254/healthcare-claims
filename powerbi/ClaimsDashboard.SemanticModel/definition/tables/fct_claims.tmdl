		annotation SummarizationSetBy = Automatic

	column patient_state
		dataType: string
		lineageTag: 47ac09e0-1da5-4123-9935-5f881b491611
		summarizeBy: none
		sourceColumn: patient_state

	column 'Age Band Sort' = SWITCH(TRUE(), fct_claims[patient_age] < 18, 1, fct_claims[patient_age] < 35, 2, fct_claims[patient_age] < 50, 3, fct_claims[patient_age] < 65, 4, 5)
		dataType: int64
		isHidden
		lineageTag: 864b9f6d-4d3e-4c97-9a68-4ee9b6a269bb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Age Band' = SWITCH(TRUE(), fct_claims[patient_age] < 18, "0-17", fct_claims[patient_age] < 35, "18-34", fct_claims[patient_age] < 50, "35-49", fct_claims[patient_age] < 65, "50-64", "65+")
		dataType: string
		lineageTag: 890a9120-ffe7-4b2b-9c8f-67e803b1e5b7
		summarizeBy: none
		sortByColumn: 'Age Band Sort'

	partition fct_claims = m
		mode: import
		source = let Source = PostgreSQL.Database("localhost", "health_care"), Data = Source{[Schema="public", Item="fct_claims"]}[Data] in Data

